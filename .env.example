# Required to download or refresh the IP2Location LITE database.
IP2LOCATION_TOKEN=

# IP2Location product code used by the download endpoint.
IP2LOCATION_DATABASE_CODE=DB3LITEBIN

LISTEN_ADDR=:8080
DATA_DIR=./data

# Optional native HTTPS. Set both paths or leave both empty.
# TLS_CERT_FILE=/run/secrets/tls.crt
# TLS_KEY_FILE=/run/secrets/tls.key

# The production default is one refresh per 24 hours.
IP2LOCATION_REFRESH_INTERVAL=24h
IP2LOCATION_DOWNLOAD_TIMEOUT=10m
